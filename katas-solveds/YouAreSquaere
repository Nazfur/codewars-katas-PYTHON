def is_square(n):    
    
    if n < 0: return False
    if n == 0: return True
    if n == 4: return True
    
    izq = 0
    j = n

    while izq <= j:
        mid = (izq + j) // 2

        if mid * mid == n:
            return True
        elif mid * mid < n:
            izq = mid + 1
        else:
            j = mid - 1

    return False

