def smart_log_formatter(logs):
if not logs:
    return []

resultado = []
actual = logs[0]
contador = 1

for msg in logs[1:]:
    if msg == actual:
        contador += 1
    else:
        if contador == 1:
            resultado.append(actual)
        else:
            resultado.append(f"{actual} (x{contador})")

        actual = msg
        contador = 1

# Añadir el último grupo
if contador == 1:
    resultado.append(actual)
else:
    resultado.append(f"{actual} (x{contador})")

return resultado
