def rgb(r, g, b):
    
    def a(number):
        
        diccionario = {"0000":"0", "0001":"1", "0010":"2", "0011":"3", "0100":"4", "0101":"5", "0110":"6", "0111":"7", "1000":"8", "1001":"9", "1010":"A", "1011":"B", "1100":"C", "1101":"D", "1110":"E","1111":"F"}
        number = bin(number)
        number = number[2:]
        
        while len(number) < 8:
            number = "0" + number
        
        bits1 = number[:4]
        bits2 = number[4:]
        
        return diccionario[bits1]+diccionario[bits2]
        
    def j(i):
        if i < 0:
            i = 0
        if i > 255:
            i = 255
        return int(i)
    
    return a(j(r)) + a(j(g)) + a(j(b))

